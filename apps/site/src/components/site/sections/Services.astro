---
import { getCollection } from 'astro:content';
import Arrow from '../Arrow.astro';
import Icon from '../Icon.astro';

const servicos = (await getCollection('servicos')).toSorted((a, b) => a.data.ordem - b.data.ordem);
---

<section id="services">
  <div class="wrap service-editorial">
    <div>
      <h2>Cada detalhe<br /><em>tem seu especialista.</em></h2>
      <p>Da torneira ao telhado. Encontre o cuidado que sua casa pede.</p>
      <a class="btn btn-primary" href="#solicitar">Encontrar uma solução <Arrow /></a>
    </div>
    <div class="editorial-services" id="services-grid">
      {
        servicos.map(({ id, data }) => (
          <div class="card">
            <div class="icon-badge">
              <Icon name={data.icone} />
            </div>
            <h3>{data.nome}</h3>
            <p>{data.descricao}</p>
            <a href={`/servicos/${id}`} aria-label={`Saiba mais sobre ${data.nome}`}>
              Saiba mais
            </a>
          </div>
        ))
      }
    </div>
    <p class="svc-legal">Serviços regulamentados, como instalações elétricas e de gás, são executados por profissionais habilitados, conforme normas técnicas e legislação vigente.</p>
  </div>
</section>
