---
import { PASSOS_COMO_FUNCIONA } from '../../../lib/passos.ts';
---

<section id="how">
  <div class="wrap">
    <div class="editorial-section-top">
      <h2>Você conta com a gente.<br /><em>A gente cuida do resto.</em></h2>
      <p>Da visita ao serviço concluído, um caminho claro e um único ponto de contato.</p>
    </div>
    <ol class="editorial-steps">
      {
        PASSOS_COMO_FUNCIONA.map(({ titulo, texto }, indice) => (
          <li>
            <span class="stage-num">{indice + 1}</span>
            <h3>{titulo}</h3>
            <p>{texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
