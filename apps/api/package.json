{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "create-admin": "node --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/rate-limit": "^11.2.2",
    "@fixable/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.44",
    "fastify": "^5",
    "fastify-type-provider-zod": "^6",
    "nodemailer": "^10.4.0",
    "postgres": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0"
  }
}
