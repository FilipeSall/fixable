{
  "name": "fixable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "dev:api": "pnpm --filter api db:migrate && pnpm --filter api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter site exec playwright test",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
