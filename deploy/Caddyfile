{
	email {$ACME_EMAIL}
}

(cabecalhos_de_seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}

{$DOMAIN} {
	encode zstd gzip

	import cabecalhos_de_seguranca

	@fora_da_caixa_de_emails not path /emails*
	header @fora_da_caixa_de_emails X-Frame-Options DENY

	log {
		output stdout
		format filter {
			request>uri regexp \?.*$ ""
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}

	import /etc/caddy/extra/*.caddy

	@astro path /_astro/*
	@pagina not path /_astro/*

	handle /api/* {
		reverse_proxy api:3333 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /app/* {
		header Cache-Control no-cache
		try_files {path} /app/index.html
		file_server
	}

	handle {
		header @pagina Cache-Control no-cache
		header @astro Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		import cabecalhos_de_seguranca
		header X-Frame-Options DENY
		header Cache-Control no-cache
		rewrite * /404.html
		file_server
	}
}
